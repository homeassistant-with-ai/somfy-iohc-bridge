// Copy this file to "secrets.h" and fill in your own values.
// "secrets.h" is in .gitignore and is therefore NEVER committed to Git.
#pragma once

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// MQTT broker - with Home Assistant this is usually the Mosquitto addon's IP/hostname.
#define MQTT_HOST     "192.168.1.10"
#define MQTT_PORT     1883
#define MQTT_USER     "mqtt-username"
#define MQTT_PASSWORD "mqtt-password"

// Address (NodeID) of YOUR OWN original Somfy remote, for the RX-sniffing
// feature (src/rx_control.cpp) - ensures the bridge only reacts to YOUR
// remote, not a neighbor's.
//
// How to find this address:
//   1. Flash the firmware once with a placeholder value (below).
//   2. Open the serial monitor and press your OWN remote.
//   3. Find the line "[RX]   src :" in the log and read off the 3 bytes.
//   4. Fill them in below and flash again.
#define SOMFY_REMOTE_SRC {0x00, 0x00, 0x00}
